APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Europe/Madrid

# Telegram credentials. Keep real values in GitHub Secrets or a local .env file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Appointment search configuration
PROVINCE=Madrid
APPOINTMENT_PROCEDURE=POLICIA - TOMA DE HUELLA (EXPEDICIÓN DE TARJETA), RENOVACIÓN DE TARJETA DE LARGA DURACIÓN y DUPLICADO
CHECK_INTERVAL_MINUTES=5
PORTAL_URL=https://icp.administracionelectronica.gob.es/icpplus/index.html
